# See docs/specs/T-00.md. Required at NODE_ENV=production (apps/worker/src/env.ts,
# validated at startup by apps/worker/src/server.ts). This list is intentionally
# short today — the worker doesn't call any real external API or DB with a real
# credential yet (see CLAUDE.md's note on T-29/T-78).

# Verifies Inngest webhook requests are genuinely from Inngest Cloud in production.
INNGEST_SIGNING_KEY=

# Port the HTTP server listens on — Railway sets this automatically.
PORT=3000
