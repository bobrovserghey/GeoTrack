# See docs/specs/T-00.md. Required at NODE_ENV=production (apps/worker/src/env.ts,
# validated at startup by apps/worker/src/server.ts). This list is intentionally
# short: engine/LLM keys are added with the real steps that use them.

# Postgres connection string (Supabase: Transaction pooler, port 6543) — the
# pipeline reads/writes audit status and events through it (T-79). Percent-encode
# special characters in the password. Same database as apps/web.
DATABASE_URL=

# Verifies Inngest webhook requests are genuinely from Inngest Cloud in production.
INNGEST_SIGNING_KEY=

# Port the HTTP server listens on — Railway sets this automatically.
PORT=3000
