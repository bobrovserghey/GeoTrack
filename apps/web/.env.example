# See docs/specs/T-00.md for what each variable is for and why it's required
# in production — this file documents shape, never real values.
# Required at NODE_ENV=production. Checked twice, by design:
#   1. at build time  — apps/web/scripts/check-env.mjs, runs before `next build`
#      (this is the check that actually fails a Vercel deploy);
#   2. at startup     — apps/web/src/lib/env.ts via apps/web/src/instrumentation.ts,
#      which covers a standalone `next start`.
# Keep the list in all three places in sync (both files above and the
# `Build web` step in .github/workflows/ci.yml).
# Optional locally — `next dev` falls back to demo data / dev-mode skips,
# same as today.

DATABASE_URL=postgres://user:password@host:5432/geotrack

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

ADMIN_SECRET=
AUDIT_SERVICE_KEY=

TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

NEXT_PUBLIC_APP_URL=https://geotrack.example

INNGEST_EVENT_KEY=

# Daily cap on free (teaser) audits accepted across the whole service.
# Warning: unset falls back to 0, and 0 means "no cap at all" (rate-limit.ts
# maps 0 to Infinity) — i.e. unlimited free audits and unbounded LLM spend,
# not a cap of zero. A non-numeric value does the same thing. Set a real
# number. See docs/specs/T-00.md.
FREE_DAILY_CEILING=50
